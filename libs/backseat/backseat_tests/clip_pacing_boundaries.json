{
  "_comment": "Boundary after each clip, per the apps' ClipPacing rules (Android core/pacing/ClipPacing.kt on #565, iOS ClipPacing PR #570). First two cases are the Kotlin ClipPacingTest cases verbatim. speakers double as voices.",
  "pause_ms": {"mid_sentence": 120, "interruption": 200, "clause": 300, "voice_change": 500, "sentence": 550,
               "dialogue_turn": 700, "paragraph": 950, "heading": 1400, "scene_break": 2000, "chapter_end": 2000},
  "cases": [
    {"name": "kotlin punctuation, paragraphs and turns",
     "text": "Chapter One\n\n“Hello,” he said, “how are you?”\n\n“Fine!” she cried. It rained—\n\n* * *\n\nThe end.",
     "pieces": ["Chapter One", "“Hello,”", "he said,", "“how are you?”", "“Fine!”", "she cried.", "It rained—", "* * *", "The end."],
     "speakers": ["N", "Tom", "N", "Tom", "Ann", "N", "N", "N", "N"],
     "expected": ["heading", "voice_change", "voice_change", "dialogue_turn", "mid_sentence", "sentence", "scene_break", "scene_break", "chapter_end"]},
    {"name": "same speaker new paragraph",
     "text": "It was late.\n\nShe slept.", "pieces": ["It was late.", "She slept."],
     "expected": ["paragraph", "chapter_end"]},
    {"name": "clause, same voice",
     "text": "Well, then.", "pieces": ["Well,", "then."], "expected": ["clause", "chapter_end"]},
    {"name": "mid sentence, no punctuation",
     "text": "The old man walked slowly home.", "pieces": ["The old man walked", "slowly home."],
     "expected": ["mid_sentence", "chapter_end"]},
    {"name": "voice change without punctuation is a clause",
     "text": "“Run” he said.", "pieces": ["“Run”", "he said."], "speakers": ["Tom", "N"],
     "expected": ["clause", "chapter_end"]},
    {"name": "ellipsis before a lowercase tag is an interruption",
     "text": "“Well…” she said.", "pieces": ["“Well…”", "she said."], "speakers": ["Ann", "N"],
     "expected": ["interruption", "chapter_end"]},
    {"name": "ellipsis then a capital is a sentence",
     "text": "He waited… Nothing came.", "pieces": ["He waited…", "Nothing came."],
     "expected": ["sentence", "chapter_end"]},
    {"name": "question then capitalised tag is a sentence",
     "text": "“Who?” Tom asked.", "pieces": ["“Who?”", "Tom asked."], "speakers": ["Ann", "N"],
     "expected": ["sentence", "chapter_end"]},
    {"name": "hyphen cut-off",
     "text": "“I-” “Stop.”", "pieces": ["“I-”", "“Stop.”"], "speakers": ["Ann", "Tom"],
     "expected": ["interruption", "chapter_end"]},
    {"name": "scene break line in the gap",
     "text": "She left.\n\n#\n\nMorning came.", "pieces": ["She left.", "Morning came."],
     "expected": ["scene_break", "chapter_end"]},
    {"name": "quoted short line is not a heading",
     "text": "“Hello there”\n\nHe smiled.", "pieces": ["“Hello there”", "He smiled."],
     "expected": ["paragraph", "chapter_end"]},
    {"name": "short unpunctuated line not at a line start is not a heading",
     "text": "It was. A dark night\n\nRain fell.", "pieces": ["It was.", "A dark night", "Rain fell."],
     "expected": ["sentence", "paragraph", "chapter_end"]},
    {"name": "prologue heading word with punctuation",
     "text": "Prologue: The Fall.\n\nIt began.", "pieces": ["Prologue: The Fall.", "It began."],
     "expected": ["heading", "chapter_end"]},
    {"name": "semicolon and colon",
     "text": "He ran; she hid: quiet.", "pieces": ["He ran;", "she hid:", "quiet."],
     "expected": ["clause", "clause", "chapter_end"]}
  ]
}
